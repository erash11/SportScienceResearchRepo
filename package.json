{
  "name": "health-performance-evidence-library",
  "private": true,
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "prototype": "vite --config vite.prototype.config.js --open",
    "prototype:build": "vite build --config vite.prototype.config.js",
    "test:pilot": "node --test scripts/tests/ask-library-pilot-core.test.mjs",
    "test:publication": "node --test scripts/tests/publication-candidate.test.mjs",
    "pilot:check": "npm run test:pilot && node scripts/ask-library-pilot.mjs check-examples",
    "pilot:request": "node scripts/ask-library-pilot.mjs request",
    "pilot:brief": "node scripts/ask-library-pilot.mjs brief",
    "pilot:feedback": "node scripts/ask-library-pilot.mjs feedback",
    "pilot:audit-source": "node scripts/ask-library-pilot.mjs audit-source",
    "pilot:score": "node scripts/ask-library-pilot.mjs score",
    "audit": "node scripts/audit-library.mjs --check && node scripts/audit-taxonomy.mjs && node scripts/audit-pilot-screening.mjs && node scripts/audit-pilot-synthesis.mjs && node scripts/audit-pilot-shortlist.mjs && node scripts/audit-zotero-publications.mjs",
    "audit:manifest": "node scripts/audit-library.mjs --write",
    "audit:taxonomy": "node scripts/audit-taxonomy.mjs",
    "audit:screening": "node scripts/audit-pilot-screening.mjs",
    "audit:synthesis": "node scripts/audit-pilot-synthesis.mjs",
    "audit:pilot": "node scripts/audit-pilot-shortlist.mjs",
    "audit:zotero": "node scripts/audit-zotero-publications.mjs",
    "candidate:check": "node scripts/zotero-publication-candidate.mjs check",
    "candidate:stage": "node scripts/zotero-publication-candidate.mjs stage",
    "candidate:apply": "node scripts/zotero-publication-candidate.mjs apply",
    "taxonomy:build": "node scripts/build-paper-taxonomy.mjs",
    "pilot:shortlist": "node scripts/build-pilot-shortlist.mjs",
    "synthesis:apply": "node scripts/apply-pilot-synthesis.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^4.5.9"
  }
}
