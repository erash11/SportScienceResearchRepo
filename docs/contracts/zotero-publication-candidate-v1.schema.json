{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erash11.github.io/SportScienceResearchRepo/contracts/zotero-publication-candidate-v1.schema.json",
  "title": "Ask the Library Zotero Publication Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "status",
    "preparedAt",
    "preparedBy",
    "publicSourceUrl",
    "source",
    "evidenceReview",
    "paper",
    "taxonomy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ask-library-publication-candidate.v1"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^zotero-[A-Za-z0-9]{6,16}-v[1-9][0-9]*$"
    },
    "status": {
      "const": "READY_FOR_LIBRARY_REVIEW"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "preparedBy": {
      "type": "string",
      "minLength": 2
    },
    "publicSourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemKey",
        "itemVersion",
        "attachmentKey",
        "pageCount",
        "title",
        "doi",
        "year"
      ],
      "properties": {
        "kind": {
          "const": "zotero"
        },
        "itemKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{6,16}$"
        },
        "itemVersion": {
          "type": "integer",
          "minimum": 1
        },
        "attachmentKey": {
          "type": "string",
          "minLength": 6
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "doi": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        }
      }
    },
    "evidenceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "paperBriefPath",
        "paperBriefSha256",
        "fullTextReviewed",
        "evidenceLocatorPages"
      ],
      "properties": {
        "artifactType": {
          "const": "paper-brief"
        },
        "paperBriefPath": {
          "type": "string",
          "minLength": 10
        },
        "paperBriefSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "fullTextReviewed": {
          "const": true
        },
        "evidenceLocatorPages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "citation",
        "doi",
        "abstract",
        "tldr",
        "methods",
        "findings",
        "limitations",
        "practicalImplications",
        "athleteDev",
        "rtp"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "citation": {
          "type": "string",
          "minLength": 10
        },
        "doi": {
          "type": "string"
        },
        "abstract": {
          "type": "string",
          "minLength": 20
        },
        "tldr": {
          "type": "string",
          "minLength": 20
        },
        "methods": {
          "type": "string",
          "minLength": 20
        },
        "findings": {
          "type": "string",
          "minLength": 20
        },
        "limitations": {
          "type": "string",
          "minLength": 20
        },
        "practicalImplications": {
          "type": "string",
          "minLength": 20
        },
        "athleteDev": {
          "type": "string",
          "minLength": 20
        },
        "rtp": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "audiences",
        "sports",
        "populations",
        "studyDesign"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "populations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "studyDesign": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
